{
  "name": "vide",
  "version": "0.3.5",
  "description": "A Claude-native IDE",
  "author": "Thomas Bonnici",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "electron-vite build",
    "build:mobile": "electron-vite build --mode mobile",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node scripts/rebrand-electron.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^3.6.0",
    "d3-force": "^3.0.1",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "minimatch": "^11.0.9",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.0",
    "remark-gfm": "^4.0.1",
    "undici": "^6.29.1",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "build": {
    "appId": "com.thomasbonnici.vide",
    "productName": "vIDE",
    "icon": "icon.png",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@vscode/ripgrep-*/**"
    ],
    "files": [
      "out/**/*",
      "electron/mobileWeb/**/*",
      "icon.png",
      "CHANGELOG.md"
    ],
    "artifactName": "vIDE-${arch}.${ext}",
    "protocols": [
      {
        "name": "vIDE",
        "schemes": ["vide"]
      }
    ],
    "mac": {
      "target": "zip",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "tar.gz",
      "executableName": "vide",
      "category": "Development"
    }
  }
}
