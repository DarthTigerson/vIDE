{
  "compilerOptions": {
    "composite": true,
    "outDir": "./.tsbuild/web",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/**/*",
    "electron/ignoredSegments.ts",
    "electron/searchShared.ts",
    "electron/searchTypes.ts",
    "electron/autocomplete/catalog.ts",
    "electron/storeRegistry.ts",
    "electron/apps/appManifest.ts",
    "electron/apps/appTypes.ts"
  ]
}
