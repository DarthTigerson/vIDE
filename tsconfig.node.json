{
  "compilerOptions": {
    "composite": true,
    "outDir": "./.tsbuild/node",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": ["electron/**/*", "electron.vite.config.ts", "src/lib/searchInMemory.ts"]
}
